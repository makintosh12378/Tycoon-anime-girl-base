local dragFloat, startFloat, startFloatPos
floatingTimerFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragFloat = true
        startFloat = input.Position
        startFloatPos = floatingTimerFrame.Position
    end
end)
floatingTimerFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragFloat = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragFloat and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - startFloat
        floatingTimerFrame.Position = UDim2.new(startFloatPos.X.Scale, startFloatPos.X.Offset + delta.X, startFloatPos.Y.Scale, startFloatPos.Y.Offset + delta.Y)
    end
end)

