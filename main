-- Настройки точек 
local Point1 = Vector3.new(332.4, 184.9, 287.4)
local Point2 = Vector3.new(428.3, 161.9, 347.8)
local Point3 = Vector3.new(532.2, 209.8, 314.6)

-- Получаем игрока и сервисы
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Создаем интерфейс
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TeleportMenu"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Главное окно (увеличили высоту до 320)
