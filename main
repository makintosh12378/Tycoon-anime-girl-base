-- ==========================================
-- ДИНАМИЧЕСКАЯ ВЫСОТА МЕНЮ
-- ==========================================
local isMinimized = false
local isSettingsOpen = false

local function updateMenuSize()
    if isMinimized then return end
    
    local activeList = isSettingsOpen and settingsList or uiList
    local targetHeight = 45 + activeList.AbsoluteContentSize.Y + 15
    
    local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 240, 0, targetHeight)})
    tween:Play()
end

uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    if not isSettingsOpen and not isMinimized then updateMenuSize() end
end)

settingsList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    if isSettingsOpen and not isMinimized then updateMenuSize() end
end)

-- ==========================================
-- ЛОГИКА НАСТРОЕК И ТЕМ
-- ==========================================
local isInfiniteJumpEnabled = false

local function updateTheme()
    currentTheme = isDarkTheme and Themes.Dark or Themes.Light
    
    mainFrame.BackgroundColor3 = currentTheme.MainBg
    topBar.BackgroundColor3 = currentTheme.PanelBg
    topCover.BackgroundColor3 = currentTheme.PanelBg
    
    title.TextColor3 = currentTheme.Text
    settingsBtn.BackgroundColor3 = currentTheme.SubText
    minBtn.BackgroundColor3 = currentTheme.SubText
    minBtn.TextColor3 = currentTheme.Text
    closeBtn.BackgroundColor3 = currentTheme.ButtonDanger
    
    themeBtn.BackgroundColor3 = currentTheme.SliderBg
    themeBtn.TextColor3 = currentTheme.Text
    themeBtn.Text = isDarkTheme and "Тема: Тёмная" or "Тема: Светлая"
    
    flySpeedTitle.TextColor3 = currentTheme.Text
    flySliderBg.BackgroundColor3 = currentTheme.SliderBg
    flySliderFill.BackgroundColor3 = currentTheme.ButtonBg

    walkSpeedTitle.TextColor3 = currentTheme.Text
    walkSliderBg.BackgroundColor3 = currentTheme.SliderBg
    walkSliderFill.BackgroundColor3 = currentTheme.ButtonBg

    infJumpBtn.BackgroundColor3 = isInfiniteJumpEnabled and currentTheme.ButtonSuccess or currentTheme.ButtonDanger

    backBtn.BackgroundColor3 = currentTheme.ButtonBg
    backBtn.TextColor3 = currentTheme.Text
    
    for _, child in pairs(contentFrame:GetChildren()) do
        if child:IsA("TextButton") then
            if child.Name ~= "FarmBtn" and child.Name ~= "FlyBtn" then
                child.BackgroundColor3 = currentTheme.ButtonBg
            end
        elseif child:IsA("Frame") then
            for _, subChild in pairs(child:GetChildren()) do
                if subChild:IsA("TextButton") and subChild.Name == "TPBtn" then
                    subChild.BackgroundColor3 = currentTheme.ButtonBg
                end
            end
        end
    end
    
    if flyBtn then flyBtn.BackgroundColor3 = isFlying and currentTheme.ButtonSuccess or currentTheme.ButtonDanger end
    if farmBtn then farmBtn.BackgroundColor3 = isFarming and currentTheme.ButtonSuccess or currentTheme.ButtonDanger end
    
    if floatingTimerFrame then
        floatingTimerFrame.BackgroundColor3 = currentTheme.PanelBg
        floatingTimerLabel.TextColor3 = currentTheme.Text
    end
end

settingsBtn.MouseButton1Click:Connect(function()
    if isMinimized then return end
    isSettingsOpen = not isSettingsOpen
    if isSettingsOpen then
        contentFrame.Visible = false
        settingsFrame.Visible = true
    else
        settingsFrame.Visible = false
        contentFrame.Visible = true
    end
    updateMenuSize()
end)

backBtn.MouseButton1Click:Connect(function()
    isSettingsOpen = false
    settingsFrame.Visible = false
    contentFrame.Visible = true
    updateMenuSize()
end)

themeBtn.MouseButton1Click:Connect(function()
    isDarkTheme = not isDarkTheme
    updateTheme()
end)

infJumpBtn.MouseButton1Click:Connect(function()
    isInfiniteJumpEnabled = not isInfiniteJumpEnabled
    infJumpBtn.Text = isInfiniteJumpEnabled and "Бесконечный прыжок: ВКЛ" or "Бесконечный прыжок: ВЫКЛ"
    infJumpBtn.BackgroundColor3 = isInfiniteJumpEnabled and currentTheme.ButtonSuccess or currentTheme.ButtonDanger
end)

-- ==========================================
-- СЛАЙДЕРЫ
-- ==========================================
local flySpeed = 50
local walkSpeed = 16
local draggingFlySlider = false
local draggingWalkSlider = false

flySliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingFlySlider = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingFlySlider = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingFlySlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mouseX = input.Position.X
        local sliderPos = flySliderBg.AbsolutePosition.X
        local sliderSize = flySliderBg.AbsoluteSize.X
        local percent = math.clamp((mouseX - sliderPos) / sliderSize, 0, 1)
        
        flySpeed = math.floor(10 + percent * 490)
        flySliderFill.Size = UDim2.new(percent, 0, 1, 0)
        flySliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
        flySpeedTitle.Text = "Скорость полёта: " .. flySpeed
    end
end)

walkSliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingWalkSlider = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingWalkSlider = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingWalkSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mouseX = input.Position.X
        local sliderPos = walkSliderBg.AbsolutePosition.X
        local sliderSize = walkSliderBg.AbsoluteSize.X
        local percent = math.clamp((mouseX - sliderPos) / sliderSize, 0, 1)
        
        walkSpeed = math.floor(16 + percent * (250 - 16))
        walkSliderFill.Size = UDim2.new(percent, 0, 1, 0)
        walkSliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
        walkSpeedTitle.Text = "Скорость бега: " .. walkSpeed

        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = walkSpeed
        end
    end
end)

-- ==========================================
-- ЛОГИКА БЕСКОНЕЧНОГО ПРЫЖКА
-- ==========================================
UserInputService.JumpRequest:Connect(function()
    if isInfiniteJumpEnabled then
        local char = player.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- ==========================================
-- КНОПКИ ТЕЛЕПОРТА
-- ==========================================
local function teleportTo(point)
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        -- Поднимаем на 3 стада, чтобы не застрять в полу
        char.HumanoidRootPart.CFrame = CFrame.new(point + Vector3.new(0, 3, 0))
    end
end

local function createTPButton(text, layoutOrder, point)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 35)
    container.BackgroundTransparency = 1
    container.LayoutOrder = layoutOrder * 10
    container.Parent = contentFrame

    local btn = Instance.new("TextButton")
    btn.Name = "TPBtn"
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = currentTheme.ButtonBg
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Parent = container
    local btnCorner = Instance.new("UICorner") btnCorner.CornerRadius = UDim.new(0, 6) btnCorner.Parent = btn

    local timerBtn = Instance.new("TextButton")
    timerBtn.Size = UDim2.new(1, 0, 0, 20)
    timerBtn.Position = UDim2.new(0, 0, 0, 38)
    timerBtn.BackgroundTransparency = 1
    timerBtn.TextColor3 = currentTheme.ButtonDanger
    timerBtn.Font = Enum.Font.GothamSemibold
    timerBtn.TextSize = 11
    timerBtn.Text = ""
    timerBtn.Visible = false
    timerBtn.Parent = container

    local isTimerRunning = false
    local cooldownTime = 15 * 60

    btn.MouseButton1Click:Connect(function()
        teleportTo(point)
        
        if not isTimerRunning then
            isTimerRunning = true
            task.delay(3, function()
                if not isTimerRunning then return end
                timerBtn.Visible = true
                local endTime = os.time() + cooldownTime
                while os.time() < endTime and isTimerRunning do
                    local timeLeft = endTime - os.time()
                    local minutes = math.floor(timeLeft / 60)
                    local seconds = timeLeft % 60
                    timerBtn.Text = string.format("Сброс через: %02d:%02d", minutes, seconds)
                    task.wait(1)
                end
                timerBtn.Visible = false
                isTimerRunning = false
            end)
        end
    end)
    
    timerBtn.MouseButton1Click:Connect(function()
        isTimerRunning = false
        timerBtn.Visible = false
    end)
    
    timerBtn:GetPropertyChangedSignal("Visible"):Connect(function()
        container.Size = timerBtn.Visible and UDim2.new(1, 0, 0, 60) or UDim2.new(1, 0, 0, 35)
    end)
end

createTPButton("1 - 4 токена", 1, Point1)
createTPButton("2 - 6 токенов", 2, Point2)
createTPButton("3 - 16 токенов", 3, Point3)

