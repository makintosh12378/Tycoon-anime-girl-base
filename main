local function stopFarm()
    isFarming = false
    farmBtn.Text = "Авто-фарм: ВЫКЛ"
    farmBtn.BackgroundColor3 = currentTheme.ButtonDanger
    floatingTimerFrame.Visible = false
    
    if farmTween then farmTween:Cancel() farmTween = nil end
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.Anchored = false end
end

farmBtn.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarm()
    else
        isFarming = true
        farmBtn.Text = "Авто-фарм: ВКЛ"
        farmBtn.BackgroundColor3 = currentTheme.ButtonSuccess
        
        task.spawn(function()
            while isFarming do
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then break end
                
                root.Anchored = true
                task.wait(0.5) -- Даем серверу время
                
                -- 1. Цикл полета по точкам
                for i, waypoint in ipairs(FarmPath) do
                    if not isFarming or not root.Parent then break end
                    
                    local targetCFrame = CFrame.new(waypoint + Vector3.new(0, 3, 0)) -- Поднимаем на 3 стада
                    
                    -- Если летим из бассейна на 1 остров, делаем это медленнее, чтобы античит не крашнул игру
                    local dist = (root.Position - waypoint).Magnitude
                    local tTime = dist > 150 and 4 or 1.5 

                    farmTween = TweenService:Create(root, TweenInfo.new(tTime, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                    farmTween:Play()
                    farmTween.Completed:Wait()
                    task.wait(0.5)
                end
                
                if not isFarming then break end

                -- 2. Телепорт в бассейн
                if root and root.Parent then
                    root.CFrame = CFrame.new(PoolPosition + Vector3.new(0, 3, 0))
                    task.wait(0.2)
                    root.Anchored = false -- Отпускаем в воду
                end
                
                floatingTimerFrame.Visible = true
                
                -- 3. Отдых 15 минут
                local restSeconds = 15 * 60 
                for i = restSeconds, 1, -1 do
                    if not isFarming then break end
                    local minutes = math.floor(i / 60)
                    local seconds = i % 60
                    local timeStr = string.format("Отдых: %02d:%02d", minutes, seconds)
                    
                    farmBtn.Text = timeStr
                    floatingTimerLabel.Text = timeStr
                    task.wait(1)
                end
                
                floatingTimerFrame.Visible = false
                
                if isFarming then
                    farmBtn.Text = "Авто-фарм: ВКЛ"
                    if root and root.Parent then
                        root.Anchored = true -- Включаем якорь перед возвращением
                        root.CFrame = root.CFrame + Vector3.new(0, 5, 0) -- Приподнимаем из воды
                        task.wait(0.5)
                    end
                end
            end
        end)
    end
end)

-- ==========================================
-- ЛОГИКА ПОЛЕТА (FLY)
-- ==========================================
local isFlying = false
local bodyVelocity
local bodyGyro

local flyBtn = Instance.new("TextButton")
flyBtn.Name = "FlyBtn"
flyBtn.Size = UDim2.new(1, 0, 0, 35)
flyBtn.BackgroundColor3 = currentTheme.ButtonDanger
flyBtn.Text = "Полёт: ВЫКЛ"
flyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
flyBtn.Font = Enum.Font.GothamBold
flyBtn.TextSize = 14
flyBtn.LayoutOrder = 40
flyBtn.Parent = contentFrame
local flyCorner = Instance.new("UICorner") flyCorner.CornerRadius = UDim.new(0, 6) flyCorner.Parent = flyBtn

local function stopFly()
    isFlying = false
    flyBtn.Text = "Полёт: ВЫКЛ"
    flyBtn.BackgroundColor3 = currentTheme.ButtonDanger
    
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.PlatformStand = false
        for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
            pcall(function() char.Humanoid:SetStateEnabled(state, true) end)
        end
        if char:FindFirstChild("Animate") then char.Animate.Disabled = false end
    end
    
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

local function startFly()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    isFlying = true
    flyBtn.Text = "Полёт: ВКЛ"
    flyBtn.BackgroundColor3 = currentTheme.ButtonSuccess

    hum.PlatformStand = true
    for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
        pcall(function() hum:SetStateEnabled(state, false) end)
    end
    if char:FindFirstChild("Animate") then char.Animate.Disabled = true end

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Parent = root
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.zero

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Parent = root
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 9e4
    bodyGyro.CFrame = root.CFrame
end

flyBtn.MouseButton1Click:Connect(function()
    if isFlying then
        stopFly()
    else
        startFly()
    end
end)

RunService.RenderStepped:Connect(function()
    if isFlying and bodyVelocity and bodyGyro then
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            stopFly()
            return
        end
        
        local camera = workspace.CurrentCamera
        local moveDir = Vector3.zero
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end

        if moveDir.Magnitude > 0 then
            bodyVelocity.Velocity = moveDir.Unit * flySpeed
        else
            bodyVelocity.Velocity = Vector3.zero
        end
        bodyGyro.CFrame = camera.CFrame
    end
end)

player.CharacterAdded:Connect(function(char)
    if isFlying then stopFly() end
    if isFarming then stopFarm() end
    task.wait(1)
    local hum = char:WaitForChild("Humanoid")
    if hum then hum.WalkSpeed = walkSpeed end
end)

-- ==========================================
-- СВОРАЧИВАНИЕ И ПЕРЕТАСКИВАНИЕ
-- ==========================================
closeBtn.MouseButton1Click:Connect(function()
    if isFlying then stopFly() end
    if isFarming then stopFarm() end
    screenGui:Destroy()
end)

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        isSettingsOpen = false
        contentFrame.Visible = false
        settingsFrame.Visible = false
        mainFrame.Size = UDim2.new(0, 240, 0, 35)
        minBtn.Text = "+"
    else
        contentFrame.Visible = true
        minBtn.Text = "-"
        updateMenuSize()
    end
end)

local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- ==========================================
-- СКРЫТИЕ МЕНЮ ПО КНОПКЕ INSERT
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        screenGui.Enabled = not screenGui.Enabled
    end
end)

-- Инициализация
updateTheme()
updateMenuSize()
